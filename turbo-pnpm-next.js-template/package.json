{
  "name": "my-app",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "prepare": "simple-git-hooks",
    "build": "turbo build",
    "dev": "turbo dev",
    "build:test": "turbo build:test",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "fmt": "turbo fmt",
    "fmt:check": "turbo fmt:check",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@commitlint/types": "^20.5.0",
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.3.3",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.56.0",
    "prettier": "^3.7.4",
    "simple-git-hooks": "^2.13.1",
    "turbo": "^2.6.3",
    "typescript": "5.7.3"
  },
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "react": "^19.2.1",
      "react-dom": "^19.2.1",
      "@types/react": "^19.2.7",
      "@types/react-dom": "^19.2.3"
    }
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged",
    "commit-msg": "pnpm commitlint --edit .git/COMMIT_EDITMSG"
  },
  "lint-staged": {
    "*": [
      "oxlint --fix",
      "eslint --fix"
    ]
  },
  "browserslist": [
    "chrome 64",
    "edge 79",
    "firefox 67",
    "opera 51",
    "safari 12"
  ]
}