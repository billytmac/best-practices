{
  "name": "nuxt-vant-mobile",
  "type": "module",
  "version": "0.6.0",
  "packageManager": "pnpm@10.30.2",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "dev:pc": "node scripts/dev.mjs pc",
    "dev:mobile": "node scripts/dev.mjs mobile",
    "dev:spre": "node scripts/dev.mjs spre",
    "generate": "nuxt generate",
    "generate:pc": "node scripts/build-all.mjs pc",
    "generate:mobile": "node scripts/build-all.mjs mobile",
    "generate:spre": "node scripts/build-all.mjs spre",
    "generate:all": "node scripts/build-all.mjs",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "commitlint": "commitlint --edit",
    "typecheck": "nuxi typecheck",
    "release": "bumpp --commit --push --tag"
  },
  "dependencies": {
    "@nuxtjs/color-mode": "^4.0.0",
    "@nuxtjs/i18n": "^10.2.3",
    "nuxt": "^4.3.1",
    "pinia-plugin-persistedstate": "^4.7.1",
    "vue": "^3.5.29",
    "vue-router": "^5.0.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.4.3",
    "@commitlint/cli": "^20.4.2",
    "@commitlint/config-conventional": "^20.4.2",
    "@iconify-json/carbon": "^1.2.18",
    "@nuxt/eslint": "^1.15.1",
    "@nuxt/image": "^2.0.0",
    "@pinia/nuxt": "^0.11.3",
    "@unocss/eslint-plugin": "66.6.0",
    "@unocss/nuxt": "66.6.0",
    "@vant/nuxt": "^1.0.7",
    "bumpp": "^10.4.1",
    "eslint": "^10.0.2",
    "eslint-plugin-format": "^1.4.0",
    "lint-staged": "^16.2.7",
    "pinia": "^3.0.4",
    "postcss-mobile-forever": "^5.0.0",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^5.9.3",
    "vant": "^4.9.22",
    "vue-tsc": "^3.2.5"
  },

  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged",
    "commit-msg": "pnpm commitlint $1"
  },
  "lint-staged": {
    "*": "eslint --fix"
  },
  "browserslist": [
    "defaults"
  ]
}
