{
  "name": "my-app",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "prepare": "simple-git-hooks",
    "build": "turbo build",
    "dev:overseas-dlwKR-appointment": "turbo dev --filter=./apps/overseas-dlwKR-appointment",
    "build:test": "turbo build:test",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "fmt": "turbo fmt",
    "fmt:check": "turbo fmt:check",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@commitlint/types": "^20.5.0",
    "@pinia-plugin-persistedstate/nuxt": "^1.2.1",
    "@types/node": "^25.3.3",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.56.0",
    "prettier": "^3.7.4",
    "simple-git-hooks": "^2.13.1",
    "turbo": "^2.6.3",
    "typescript": "5.7.3",
    "vconsole": "^3.15.1"
  },
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=20"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged",
    "commit-msg": "pnpm commitlint --edit .git/COMMIT_EDITMSG"
  },
  "lint-staged": {
    "*": [
      "oxlint --fix",
      "eslint --fix"
    ]
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "citty": "0.2.1",
        "eslint": "10.*"
      }
    },
    "allowedDeprecatedVersions": {
      "glob": "*",
      "inflight": "1",
      "are-we-there-yet": "2",
      "gauge": "3",
      "node-domexception": "1",
      "npmlog": "5",
      "rimraf": "3",
      "@types/parse-path": "7",
      "@oxc-parser/wasm": "0.60.0",
      "unplugin-vue-router": "*"
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "simple-git-hooks",
      "unrs-resolver"
    ]
  },
  "resolutions": {
    "vite": "^7.3.1",
    "vue-router": "^5.0.3"
  },
  "dependencies": {
    "@unocss/reset": "^66.6.8",
    "@vueuse/core": "^14.2.1",
    "animate.css": "^4.1.1",
    "axios": "^1.15.2",
    "swiper": "^12.1.3"
  }
}